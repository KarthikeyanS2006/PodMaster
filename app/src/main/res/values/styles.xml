<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PodMaster" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        
        <!-- Text appearances -->
        <item name="textAppearanceHeadline6">@style/TextAppearance.PodMaster.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.PodMaster.Subtitle1</item>
        <item name="textAppearanceBody1">@style/TextAppearance.PodMaster.Body1</item>
        
        <!-- Button styles -->
        <item name="materialButtonStyle">@style/Widget.PodMaster.Button</item>
    </style>

    <!-- Text Styles -->
    <style name="TextAppearance.PodMaster.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PodMaster.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.PodMaster.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Button Style -->
    <style name="Widget.PodMaster.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="backgroundTint">@color/primary</item>
    </style>
</resources>