<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light Theme - White & Orange -->
    <style name="Base.Theme.PodMaster" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary Orange -->
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryVariant">@color/orange_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary Orange -->
        <item name="colorSecondary">@color/orange_accent</item>
        <item name="colorSecondaryVariant">@color/orange_primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>

        <!-- Error -->
        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/white</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/orange_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/background_light</item>
    </style>

    <style name="Theme.PodMaster" parent="Base.Theme.PodMaster" />

    <!-- Button Styles -->
    <style name="Widget.PodMaster.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/orange_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- FAB Style -->
    <style name="Widget.PodMaster.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/orange_primary</item>
        <item name="tint">@color/white</item>
    </style>
</resources>
